{
 "name": "Template Documento",
 "module": "Advocacia",
 "doctype": "DocType",
 "custom": 0,
 "autoname": "field:titulo",
 "naming_rule": "By fieldname",
 "title_field": "titulo",
 "search_fields": "titulo,tipo_documento",
 "is_submittable": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "titulo",
   "fieldtype": "Data",
   "label": "Titulo",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Nome do modelo. Identificador único no catálogo."
  },
  {
   "fieldname": "tipo_documento",
   "fieldtype": "Select",
   "label": "Tipo de Documento",
   "options": "Contrato\nDeclaracao\nRecibo\nCarta\nFicha de Atendimento\nOutro",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Tipo: Petição, Contrato, Procuração, etc."
  },
  {
   "fieldname": "descricao",
   "fieldtype": "Small Text",
   "label": "Descricao",
   "description": "Descrição do uso deste modelo."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "habilitado",
   "fieldtype": "Check",
   "label": "Habilitado",
   "default": "1",
   "in_list_view": 1,
   "description": "Desmarque para ocultar o modelo na geração de documentos."
  },
  {
   "fieldname": "arquivo",
   "fieldtype": "Attach",
   "label": "Arquivo Template (.docx)",
   "reqd": 1,
   "description": "Upload do modelo .docx com placeholders no formato {{ nome_do_campo }}. Clique em 'Ver Placeholders' abaixo para ver a lista completa."
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Placeholders Disponiveis"
  },
  {
   "fieldname": "ver_placeholders",
   "fieldtype": "Button",
   "label": "Ver Placeholders Disponíveis",
   "description": "Clique para ver todos os placeholders que podem ser usados nos templates .docx"
  }
 ],
 "permissions": [
  {
   "role": "Advocacia Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Advocacia User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "print": 1,
   "email": 1
  }
 ],
 "sort_field": "titulo",
 "sort_order": "ASC",
 "show_title_field_in_link": 1
}
