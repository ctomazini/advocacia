{
 "name": "Document Template",
 "module": "Advocacia",
 "doctype": "DocType",
 "custom": 0,
 "autoname": "field:title",
 "naming_rule": "By fieldname",
 "title_field": "title",
 "search_fields": "title,document_type",
 "is_submittable": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Titulo",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Nome do modelo. Identificador único no catálogo.",
   "idx": 1
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Select",
   "label": "Tipo de Documento",
   "options": "Contrato\nDeclaracao\nRecibo\nCarta\nFicha de Atendimento\nOutro",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Tipo: Petição, Contrato, Procuração, etc.",
   "idx": 2
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Descricao",
   "description": "Descrição do uso deste modelo.",
   "idx": 3
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "idx": 4
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Habilitado",
   "default": "1",
   "in_list_view": 1,
   "description": "Desmarque para ocultar o modelo na geração de documentos.",
   "idx": 5
  },
  {
   "fieldname": "template_file",
   "fieldtype": "Attach",
   "label": "Arquivo Template (.docx)",
   "reqd": 1,
   "description": "Upload do modelo .docx com placeholders no formato {{ nome_do_campo }}. Clique em 'Ver Placeholders' abaixo para ver a lista completa.",
   "idx": 6
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Placeholders Disponiveis",
   "idx": 7
  },
  {
   "fieldname": "show_placeholders",
   "fieldtype": "Button",
   "label": "Ver Placeholders Disponíveis",
   "description": "Clique para ver todos os placeholders que podem ser usados nos templates .docx",
   "idx": 8
  }
 ],
 "permissions": [
  {
   "role": "Advocacia Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "idx": 1
  },
  {
   "role": "Advocacia User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "export": 1,
   "print": 1,
   "email": 1,
   "idx": 2
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "idx": 3
  }
 ],
